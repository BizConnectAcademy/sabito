NODE_ENV=development
PORT=4100
PUBLIC_URL=https://chat.bizconnectacademy.com
LOG_LEVEL=info
DATABASE_URL=mysql://sabito:sabito_password@127.0.0.1:3307/sabito_bca
MYSQL_PASSWORD=sabito_password
MYSQL_ROOT_PASSWORD=change_root_password
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_SECRET_PEPPER=replace-with-another-32-character-random-value
ADMIN_API_KEY=replace-with-a-dashboard-admin-key-of-at-least-24-characters
JWT_ISSUER=sabito-bca
JWT_AUDIENCE=sabito-platforms
JWT_TTL_SECONDS=900
# Add browser applications that connect to Sabito. Its own PUBLIC_URL and local PORT are automatic.
CORS_ORIGINS=http://localhost:3000,http://localhost:4101,https://bizconnectacademy.com,https://www.bizconnectacademy.com,https://buzz-booster.site
